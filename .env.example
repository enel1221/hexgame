# Browser-visible URL of the standalone multiplayer relay. This is not a secret.
NEXT_PUBLIC_MULTIPLAYER_URL=http://127.0.0.1:8787

# Plaintext Worker bindings mirrored by wrangler.multiplayer.jsonc for local use.
# Set production values in the Cloudflare environment/configuration.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROOM_TTL_SECONDS=21600
COMMAND_LEAD_TICKS=6
