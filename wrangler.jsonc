{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hex-dominion",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "env": {
    "main": {
      "name": "hex-dominion-main",
      "images": {
        "binding": "IMAGES"
      },
      "routes": [
        {
          "pattern": "main.hex-dominion.inkgrid.io",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "name": "hex-dominion",
      "images": {
        "binding": "IMAGES"
      },
      "routes": [
        {
          "pattern": "hex-dominion.inkgrid.io",
          "custom_domain": true,
        },
      ],
    },
  },
}
