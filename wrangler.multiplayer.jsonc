{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hex-dominion-multiplayer",
  "main": "src/edge/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"],
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173",
    "ROOM_TTL_SECONDS": "21600",
    "COMMAND_LEAD_TICKS": "6",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "main": {
      "name": "hex-dominion-multiplayer-main",
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomDurableObject",
          },
        ],
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://main.hex-dominion.inkgrid.io",
        "ROOM_TTL_SECONDS": "21600",
        "COMMAND_LEAD_TICKS": "6",
      },
      "routes": [
        {
          "pattern": "relay-main.hex-dominion.inkgrid.io",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "name": "hex-dominion-multiplayer",
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomDurableObject",
          },
        ],
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://hex-dominion.inkgrid.io",
        "ROOM_TTL_SECONDS": "21600",
        "COMMAND_LEAD_TICKS": "6",
      },
      "routes": [
        {
          "pattern": "relay.hex-dominion.inkgrid.io",
          "custom_domain": true,
        },
      ],
    },
  },
}
